# ABDM sandbox credentials — never commit. Loaded by backend plug settings (prefix ABDM_).
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=
ABDM_GATEWAY_URL=https://dev.abdm.gov.in
# HSP Registry host. It serves the HRP service registration only.
ABDM_HSP_URL=https://apihspsbx.abdm.gov.in
ABDM_ABHA_URL=https://abhasbx.abdm.gov.in/abha/api
ABDM_CM_ID=sbx
# public tunnel URL to local Care, set when the tunnel is up (ADR-005)
ABDM_CALLBACK_BASE_URL=
ABDM_CALLBACK_SIGNATURE_HEADER=Authorization
# Scan and Share counter QR code. The docs do not publish the URL format (findings D1).
# Placeholders: {hip_id} and {context}. Empty = the setup page shows no QR code.
ABDM_SHARE_QR_URL_TEMPLATE=
# ADR-013: a failed link call is repeated this often, this many times; then the record is marked failed.
ABDM_LINK_RETRY_INTERVAL_MINUTES=60
ABDM_LINK_MAX_RETRIES=3
