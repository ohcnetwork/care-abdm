meta {
  name: 2. Registry search before a facility exists
  type: http
  seq: 2
}

get {
  url: {{careUrl}}/api/abdm/hfr/search?name=&state=&district=&page=1
  body: none
  auth: none
}

params:query {
  name: 
  state: 
  district: 
  page: 1
}

headers {
  Authorization: ******
}

docs {
  The same registry search as `nhpr/2-hfr-search`, before a Care facility exists. `name` needs 3
  characters; `state` and `district` are LGD codes. `?facility_id=IN...` looks 1 record up instead.
  Needs `can_create_facility`.
}
