meta {
  name: 2. Registry search before a facility exists
  type: http
  seq: 2
}

get {
  url: {{careUrl}}/api/abdm/hfr/search?name=&state=&ownership=&district=&page=1
  body: none
  auth: none
}

params:query {
  name: 
  state: 
  ownership: 
  district: 
  page: 1
}

headers {
  Authorization: ******
}

docs {
  The same registry search as `nhpr/2-hfr-search`, before a Care facility exists. `name` needs 3
  characters; `state` (required) and `district` are LGD codes; `ownership` (required) is `G`, `P`
  or `PP`. `?facility_id=IN...` looks 1 record up instead. Needs `can_create_facility`.
}
