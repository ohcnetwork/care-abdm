meta {
  name: 15. health information request (v0.5)
  type: http
  seq: 15
}

post {
  url: {{careUrl}}/api/abdm/v0.5/health-information/hip/request
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{callbackToken}}
  REQUEST-ID: {{requestId}}
  TIMESTAMP: {{timestamp}}
  X-HIP-ID: {{hipId}}
  Content-Type: application/json
}

body:json {
  {
    "transactionId": "{{requestId}}",
    "hiRequest": {
      "consent": { "id": "{{consentId}}" },
      "dateRange": { "from": "2020-01-01T00:00:00.000Z", "to": "2030-01-01T00:00:00.000Z" },
      "dataPushUrl": "https://hiu.example.test/data/push",
      "keyMaterial": {
        "cryptoAlg": "ECDH",
        "curve": "Curve25519",
        "dhPublicKey": {
          "expiry": "2030-01-01T00:00:00.000Z",
          "parameters": "Curve25519/32byte",
          "keyValue": "{{hiuPublicKey}}"
        },
        "nonce": "{{hiuNonce}}"
      }
    }
  }
}

docs {
  Inbound health-information request. Operation id `m2-on-health-information-request`.
  The HIP page publishes no body. This shape comes from the HIU request page
  (m3-hiu-health-information-request) plus `transactionId`, as the P2 on-share page shows it.
  `hiuPublicKey` = base64 of a 32-byte X25519 public key; `hiuNonce` = base64 of 32 random bytes.
  The plug acknowledges, builds and encrypts the bundles, pushes them to `dataPushUrl`, and notifies.
}
