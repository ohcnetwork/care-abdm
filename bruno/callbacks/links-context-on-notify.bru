}

body:json {
  {
    "acknowledgement": {
      "status": "SUCCESS"
    },
    "error": {
      "code": "<CODE>",
      "message": "<MESSAGE>"
    },
    "response": {
      "requestId": "<REQUEST_ID>"
    }
  }
}

docs {
  Result of `m2-link-care-context-notify`. Operation id `m2-on-context-notify-result`.
  `acknowledgement.status` is `SUCCESS` or `ERRORED`.

  Path: `/api/abdm/api/v3/links/context/on-notify`.
}
