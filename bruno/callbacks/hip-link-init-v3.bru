meta {
  name: 9. link init (v3)
  type: http
  seq: 9
}

post {
  url: {{careUrl}}/api/abdm/api/v3/hip/link/care-context/init
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{callbackToken}}
  REQUEST-ID: {{requestId}}
  TIMESTAMP: {{timestamp}}
  X-HIP-ID: {{hipId}}
  Content-Type: application/json
}

body:json {
  {
    "transactionId": "<TRANSACTION_ID>",
    "abhaAddress": "<ABHA_ADDRESS>",
    "patient": [
      {
        "referenceNumber": "<REFERENCE_NUMBER>",
        "display": "<DISPLAY>",
        "careContexts": [
          "<CARE_CONTEXTS>"
        ],
        "hiType": "<HI_TYPE>",
        "count": 0
      }
    ]
  }
}

docs {
  Inbound request to start a user link. Operation id `m2-on-link-init`.
  A repeat arrives as ABDM-1104. A refusal arrives as ABDM-1110.

  Path: `/api/abdm/api/v3/hip/link/care-context/init`.
}
