meta {
  name: 19. HIU consent on-fetch
  type: http
  seq: 19
}

post {
  url: {{careUrl}}/api/abdm/api/v3/hiu/consent/on-fetch
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{callbackToken}}
  REQUEST-ID: {{requestId}}
  TIMESTAMP: {{timestamp}}
  X-HIU-ID: {{hipId}}
  Content-Type: application/json
}

body:json {
  {
    "consent": {
      "status": "GRANTED",
      "consentDetail": {
        "consentId": "{{consentId}}",
        "hip": { "id": "{{otherHipId}}", "name": "Other Hospital", "type": "HIP" },
        "hiu": { "id": "{{hipId}}", "name": "HIU", "type": "HIU" },
        "hiTypes": ["Prescription", "OPConsultation"],
        "patient": { "id": "{{abhaAddress}}" },
        "purpose": { "text": "Care Management", "code": "CAREMGT", "refUri": "www.abc.com" },
        "createdAt": "{{timestamp}}",
        "requester": { "name": "Dr X", "identifier": { "value": "REG1", "type": "MH1001", "system": "https://www.sample.com" } },
        "permission": {
          "accessMode": "VIEW",
          "dateRange": { "from": "2025-09-19T00:00:00.000Z", "to": "2026-09-19T00:00:00.000Z" }
        },
        "dataEraseAt": "2026-12-31T00:00:00.000Z",
        "frequency": { "unit": "HOUR", "value": 1, "repeats": 0 },
        "lastUpdated": "{{timestamp}}",
        "careContexts": [ { "patientReference": "PAT-1", "careContextReference": "EPISODE-1" } ],
        "schemaVersion": "v3",
        "consentManager": { "id": "sbx" }
      },
      "signature": "<SIGNATURE>"
    },
    "error": null,
    "response": { "requestId": "{{outboundRequestId}}" },
    "resp": null
  }
}

docs {
  M3 journey 3, step 1: the artefact detail. Answers `consent/v3/fetch`; set `outboundRequestId` to its
  REQUEST-ID. Operation id `m3-on-consent-fetch`. A live GRANTED artefact starts
  `health-information/request` at once (fresh X25519 key, our data push URL). Body: .../08.
}
