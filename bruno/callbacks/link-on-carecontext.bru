  Content-Type: application/json
}

body:json {
  {
    "abhaAddress": "<ABHA_ADDRESS>",
    "status": "<STATUS>",
    "error": {
      "code": "<CODE>",
      "message": "<MESSAGE>"
    },
    "response": {
      "requestId": "<REQUEST_ID>"
    }
  }
}

docs {
  Result of `m2-hip-link-care-context`. Operation id `m2-on-carecontext-result`.
  `status` is free text. One observed value is `invalid   [invalid request]`.

  Path: `/api/abdm/api/v3/link/on_carecontext`.
}
