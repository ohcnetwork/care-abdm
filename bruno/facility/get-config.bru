meta {
  name: 1. Get ABDM config
  type: http
  seq: 1
}

get {
  url: {{careUrl}}/api/abdm/facilities/{{facilityId}}/abdm
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{careToken}}
}

docs {
  Read `Facility.extensions.abdm`.
  The response also gives `hrp_registered_at`, `last_error`, and the Scan and Share QR template.
}
