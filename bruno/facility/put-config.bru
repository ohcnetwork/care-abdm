meta {
  name: 2. Save ABDM config
  type: http
  seq: 2
}

put {
  url: {{careUrl}}/api/abdm/facilities/{{facilityId}}/abdm
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{careToken}}
  Content-Type: application/json
}

body:json {
  {
    "facility_id": "",
    "facility_name": "",
    "hip_name": "",
    "counters": ["OPD1", "Pharmacy"]
  }
}

docs {
  Write the facility ABDM config. Send the full object. Empty strings clear a field.
  The server ignores hip_id in the body. GET returns hip_id derived from facility_id.
  The bridge is instance-level: see the `bridge` folder.
  `counters` lists the Scan and Share counter codes. Each code has 1 to 20 letters or digits.
  A code must not be the facility ID, the HIP ID, or the HIP name.
}
