meta {
  name: 9. HPR login
  type: http
  seq: 9
}

post {
  url: {{careUrl}}/api/abdm/users/me/abdm/hpr/login
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{careToken}}
  Content-Type: application/json
}

body:json {
  { "method": "password", "hpr_id": "{{hprId}}", "password": "{{hprPassword}}" }
}
docs {
  `method` password (`authPassword`) or aadhaar_otp (`auth/init` -> 10). The token stays on the server.
}
