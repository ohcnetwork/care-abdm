meta {
  name: 3. Select account
  type: http
  seq: 3
}

post {
  url: {{careUrl}}/api/abdm/abha/login/select-account
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{careToken}}
  Content-Type: application/json
}

body:json {
  {
    "txn_id": "{{txnId}}",
    "abha_number": "{{abhaNumber}}"
  }
}

docs {
  Select one ABHA from the `accounts` list. Use this step only after a mobile login
  that gave more than one account.
}
